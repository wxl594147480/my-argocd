# 复制成 .env 使用：cp .env.example .env
# .env 已被 .gitignore 和 .dockerignore 忽略，绝对不要提交。
# 这里的值与 workflow 里 test job 的 services 对齐，本地起同样的容器即可复用。

# ---- 应用 ----
APP_ENV=local
LOG_LEVEL=debug
HTTP_PORT=8080

# ---- 测试依赖（对应 workflow services）----
DATABASE_URL=postgres://demo:demo@127.0.0.1:5432/demo
VALKEY_URL=redis://127.0.0.1:6379/0
AMQP_URL=amqp://demo:demo@127.0.0.1:5672/
RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672

# ---- 敏感项：本地用假值，CI 和集群由 Secret 注入 ----
JWT_SECRET=local-dev-only
